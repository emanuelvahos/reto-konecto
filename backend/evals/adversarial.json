    {"id": "ADV-28", "lang": "en", "category": "3phase_modulating", "turns": ["Does 764B00-11330C00/A have a modulating torque rating?"],
     "expect": {"tools_include": ["lookup_actuator_by_part_number"], "alerts_any": ["SINGLE_TORQUE_RATING"], "answer_any": ["single", "no separate", "does not", "doesn't", "not (list|give|specif|distinguish)", "no modulating"], "answer_none": ["modulating torque (of|is|rating of) \\d"]}},
    {"id": "ADV-29", "lang": "en", "category": "knowledge", "turns": ["What voltage tolerance is allowed for Series 76 motors?"],
     "expect": {"intent": ["knowledge"], "answer_any": ["10"]}},
    {"id": "ADV-30", "lang": "es", "category": "clarification_flow", "turns": ["Necesito un actuador on/off de 250 Nm a 110V", {"pick_option": 0}],
     "expect": {"intent": ["recommend"], "display_type": ["RECOMMENDATION_LIST"], "ui_all_enclosure": "Explosionproof"}}
  ]
}
