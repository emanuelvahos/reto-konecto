    {"id": "ADV-11", "lang": "es", "category": "24v_weatherproof", "turns": ["Quiero un actuador de 24V weatherproof"],
     "expect": {"intent": ["recommend"], "tool_status_any": ["NO_MATCH_HARD_CONSTRAINTS"], "alerts_any": ["VOLTAGE_ENCLOSURE_UNAVAILABLE"], "no_ui_actuators": true, "answer_any": ["no (hay|existe|se ofrece|ofrece)", "solo", "únicamente", "explosion"]}},
    {"id": "ADV-12", "lang": "en", "category": "24v_weatherproof", "turns": ["Show me the 24V Weatherproof models with at least 100 Nm"],
