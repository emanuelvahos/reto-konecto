# =====================================================================
# 1. DATABASE & HOST PORT CONFIGURATION
# =====================================================================
POSTGRES_USER=konecto
POSTGRES_PASSWORD=konecto_secret_2026
POSTGRES_DB=series76_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://konecto:konecto_secret_2026@db:5432/series76_db

# Host port mappings (avoids collisions with existing local PostgreSQL 5432 or port 8000 services)
DB_HOST_PORT=5433
API_HOST_PORT=8001

# =====================================================================
# 2. LLM PROVIDER (perfiles en backend/config/llm_profiles.json)
# =====================================================================
# LLM_PROVIDER elige el perfil: openrouter (por defecto) | nim
LLM_PROVIDER=openrouter

# Perfil OpenRouter (entrega final)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_API_KEY=your_openrouter_api_key_here

# Perfil NVIDIA NIM (desarrollo, $0): descomenta y cambia LLM_PROVIDER=nim
# LLM_BASE_URL_NIM=https://integrate.api.nvidia.com/v1
# LLM_CHAT_MODEL_NIM=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_API_KEY_NIM=your_nvidia_nim_key_here

# =====================================================================
# 3. AUTHENTICATION & SECURITY (Optional Feature: Login & Multi-User)
# =====================================================================
JWT_SECRET_KEY=super_secret_konecto_jwt_key_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
