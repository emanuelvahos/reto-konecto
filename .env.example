# =====================================================================
# 1. DATABASE & HOST PORT CONFIGURATION
# =====================================================================
POSTGRES_USER=konecto
POSTGRES_PASSWORD=konecto_secret_2026
POSTGRES_DB=series76_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://konecto:konecto_secret_2026@db:5432/series76_db

# Host port mappings (avoids collisions with existing local PostgreSQL 5432 or port 8000 services)
DB_HOST_PORT=5433
API_HOST_PORT=8001

# =====================================================================
# 2. LLM & EMBEDDINGS CONFIGURATION (OpenRouter / NVIDIA NIM)
# =====================================================================
# OPTION A — PRODUCTION / EVALUATION DELIVERY (OpenRouter $10 USD Cap):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_api_key_here
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_VISION_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# OPTION B — ZERO-COST DEVELOPMENT & BENCHMARKING (NVIDIA NIM Free Tier):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-your_nvidia_nim_key_here
# LLM_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# EMBEDDING_DIMENSIONS=2048

# =====================================================================
# 3. AUTHENTICATION & SECURITY (Optional Feature: Login & Multi-User)
# =====================================================================
JWT_SECRET_KEY=super_secret_konecto_jwt_key_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
