# Copiar a .env. Todo es opcional: sin .env se usan los valores por defecto de demostracion
# y el backend responde con el aviso de servicio no disponible (sin LLM). .env esta ignorado por git.

# ---- Base de datos (VALORES DE DEMOSTRACION: cambiar fuera de una demo local) ----
POSTGRES_USER=konecto
POSTGRES_PASSWORD=konecto_secret_2026
POSTGRES_DB=series76_db
# Puertos del host (evitan chocar con un PostgreSQL local en 5432 o servicios en 8000)
DB_HOST_PORT=5433
API_HOST_PORT=8001
# Solo para ejecutar scripts/pruebas desde el host (en Docker la API usa db:5432 automaticamente)
DATABASE_URL=postgresql://konecto:konecto_secret_2026@localhost:5433/series76_db

# ---- Proveedor LLM (perfiles en backend/config/llm_profiles.json) ----
# LLM_PROVIDER: nim (NVIDIA NIM, tier gratuito, desarrollo) | openrouter (entrega final, de pago)
LLM_PROVIDER=nim

# Perfil NIM: base URL, modelo y clave
LLM_BASE_URL_NIM=https://integrate.api.nvidia.com/v1
LLM_CHAT_MODEL_NIM=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_API_KEY_NIM=

# Perfil OpenRouter: base URL, modelo y clave
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=openai/gpt-4o-mini
LLM_API_KEY=

# Modelos por rol: hoy hay un solo rol (chat/agente de herramientas) y por eso un solo modelo por perfil.
# El router, el verificador numerico y las plantillas de respaldo son deterministas y no usan LLM.
# Las claves SIEMPRE vacias en este archivo: ponerlas solo en .env.

# ---- Login opcional (VALORES DE DEMOSTRACION) ----
JWT_SECRET_KEY=demo-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Contrasenas de los 3 usuarios demo que siembra scripts/ingest.py
DEMO_PASSWORD_ENGINEER=Konecto2026!
DEMO_PASSWORD_SUPERVISOR=Series76Pass!
DEMO_PASSWORD_ADMIN=AdminKonecto!
